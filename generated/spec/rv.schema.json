{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcl.example/rv-exchange/v1/rv.schema.json",
  "title": "RV Exchange Format v1",
  "description": "Portable, language-neutral serialization of a random variable. The document wraps a single root RV node. An RV node is a recursive tagged union over four semantic kinds: leaf | joint | mixture | transform.",
  "x-rvx-semantics": {
    "contract": "This object is the machine-readable hand-off contract for implementation generation. JSON Schema keywords define structure; this x-rvx-semantics object defines the semantic rules that JSON Schema cannot express.",
    "versioning": {
      "implemented_major": 1,
      "reject_if_format_major_exceeds": 1,
      "semantic_versioning": "PATCH is editorial, MINOR is backward-compatible addition, MAJOR is breaking."
    },
    "tolerances": {
      "probability_sum_abs": 1e-9,
      "deterministic_output_abs": 1e-9
    },
    "canonical_json": {
      "encoding": "utf-8",
      "object_keys": "sort lexicographically at every object level",
      "arrays": "preserve order",
      "numbers": "shortest round-trippable decimal representation",
      "roundtrip": "read -> write -> read -> write must be byte-stable"
    },
    "operations": {
      "sample": "Draw n values using a deterministic seeded RNG.",
      "log_prob": "Natural log of probability density for continuous variables or mass for discrete variables. Always compute in log-space.",
      "cdf": "Cumulative probability P(X <= x).",
      "moments": "Return analytic mean and variance when available; otherwise fail explicitly."
    },
    "capability_rules": {
      "leaf_analytic": { "can_sample": true, "can_log_prob": true, "can_cdf": true },
      "leaf_categorical": { "can_sample": true, "can_log_prob": true, "can_cdf": true },
      "leaf_poisson": { "can_sample": true, "can_log_prob": true, "can_cdf": true },
      "leaf_binomial": { "can_sample": true, "can_log_prob": true, "can_cdf": true },
      "leaf_empirical": { "can_sample": true, "can_log_prob": true, "can_cdf": true },
      "joint": "AND each capability over dims",
      "mixture": "AND each capability over components",
      "transform": {
        "can_sample": "base.can_sample",
        "can_log_prob": "base.can_log_prob && op.invertible",
        "can_cdf": "base.can_cdf && op.monotone"
      },
      "validation": "If a node declares capabilities, consumers MUST recompute them bottom-up and reject mismatches."
    },
    "leaf_distributions": {
      "normal": {
        "params": ["mu", "sigma"],
        "constraints": ["sigma > 0"],
        "support": "(-inf, +inf)",
        "log_prob": "-0.5*((x-mu)/sigma)^2 - log(sigma) - 0.5*log(2*pi)",
        "cdf": "0.5*(1 + erf((x-mu)/(sigma*sqrt(2))))",
        "sample": "mu + sigma * standard_normal(seed)",
        "moments": { "mean": "mu", "variance": "sigma^2" }
      },
      "lognormal": {
        "params": ["mu", "sigma"],
        "constraints": ["sigma > 0", "x > 0 for density/CDF"],
        "support": "(0, +inf)",
        "meaning": "log(X) ~ Normal(mu, sigma)",
        "log_prob": "normal_log_prob(log(x); mu, sigma) - log(x)",
        "cdf": "normal_cdf(log(x); mu, sigma)",
        "sample": "exp(normal(mu, sigma))",
        "moments": { "mean": "exp(mu + sigma^2/2)", "variance": "(exp(sigma^2)-1)*exp(2*mu + sigma^2)" }
      },
      "weibull": {
        "params": ["shape", "scale"],
        "constraints": ["shape > 0", "scale > 0"],
        "support": "[0, +inf)",
        "log_prob": "log(shape) - log(scale) + (shape-1)*log(x/scale) - (x/scale)^shape for x >= 0, else -inf",
        "cdf": "1 - exp(-(x/scale)^shape) for x >= 0, else 0",
        "sample": "scale * (-log(1-u))^(1/shape)",
        "moments": { "mean": "scale*Gamma(1+1/shape)", "variance": "scale^2*(Gamma(1+2/shape)-Gamma(1+1/shape)^2)" }
      },
      "uniform": {
        "params": ["low", "high"],
        "constraints": ["high > low"],
        "support": "[low, high]",
        "log_prob": "-log(high-low) inside support, else -inf",
        "cdf": "0 below low, (x-low)/(high-low) inside support, 1 above high",
        "sample": "low + (high-low)*u",
        "moments": { "mean": "(low+high)/2", "variance": "(high-low)^2/12" }
      },
      "exponential": {
        "params": ["rate"],
        "constraints": ["rate > 0"],
        "support": "[0, +inf)",
        "log_prob": "log(rate) - rate*x for x >= 0, else -inf",
        "cdf": "1 - exp(-rate*x) for x >= 0, else 0",
        "sample": "-log(1-u)/rate",
        "moments": { "mean": "1/rate", "variance": "1/rate^2" }
      },
      "gamma": {
        "params": ["shape", "scale"],
        "constraints": ["shape > 0", "scale > 0"],
        "support": "(0, +inf)",
        "log_prob": "(shape-1)*log(x) - x/scale - lgamma(shape) - shape*log(scale) for x > 0, else -inf",
        "cdf": "regularized lower incomplete gamma P(shape, x/scale)",
        "sample": "standard gamma(shape) * scale",
        "moments": { "mean": "shape*scale", "variance": "shape*scale^2" }
      },
      "beta": {
        "params": ["alpha", "beta"],
        "constraints": ["alpha > 0", "beta > 0"],
        "support": "[0, 1]",
        "log_prob": "(alpha-1)*log(x) + (beta-1)*log(1-x) - (lgamma(alpha)+lgamma(beta)-lgamma(alpha+beta)) inside [0,1], else -inf",
        "cdf": "regularized incomplete beta I_x(alpha,beta)",
        "sample": "gamma(alpha,1)/(gamma(alpha,1)+gamma(beta,1))",
        "moments": { "mean": "alpha/(alpha+beta)", "variance": "alpha*beta/((alpha+beta)^2*(alpha+beta+1))" }
      },
      "categorical": {
        "discrete": true,
        "params": ["categories", "probs"],
        "constraints": ["same length", "non-empty", "probs >= 0", "sum(probs) == 1 within tolerance"],
        "support": "finite numeric categories",
        "log_prob": "log(probability for category equal to x), else -inf",
        "cdf": "sum probabilities whose category <= x after sorting categories ascending",
        "sample": "draw category by probability weights",
        "moments": { "mean": "sum(categories_i*probs_i)", "variance": "sum(probs_i*(categories_i-mean)^2)" }
      },
      "poisson": {
        "discrete": true,
        "params": ["rate"],
        "constraints": ["rate > 0"],
        "support": "{0, 1, 2, ...}",
        "log_prob": "k*log(rate) - rate - lgamma(k+1) for non-negative integer k (see discrete_evaluation.integer_snap), else -inf",
        "cdf": "1 - regularized lower incomplete gamma P(floor(x)+1, rate) for x >= 0, else 0",
        "sample": "count standard-exponential arrivals until their cumulative sum exceeds rate; the count minus 1 is the draw (exact, underflow-safe)",
        "moments": { "mean": "rate", "variance": "rate" }
      },
      "binomial": {
        "discrete": true,
        "params": ["n", "p"],
        "constraints": ["n integer >= 1", "0 < p < 1"],
        "support": "{0, 1, ..., n}",
        "log_prob": "lgamma(n+1) - lgamma(k+1) - lgamma(n-k+1) + k*log(p) + (n-k)*log(1-p) for integer 0 <= k <= n (see discrete_evaluation.integer_snap), else -inf",
        "cdf": "0 for x < 0; 1 for x >= n; otherwise regularized incomplete beta I_(1-p)(n-k, k+1) with k = floor(x)",
        "sample": "sum of n Bernoulli(p) draws (uniform < p)",
        "moments": { "mean": "n*p", "variance": "n*p*(1-p)" }
      },
      "empirical": {
        "params": ["samples"],
        "constraints": ["samples is a 1-D numeric bulk_ref"],
        "support": "sample data range",
        "log_prob": "Gaussian KDE using Scott bandwidth h = n^(-1/5)*sample_stddev",
        "cdf": "empirical CDF",
        "sample": "bootstrap or inverse empirical quantile sampling",
        "moments": { "mean": "sample mean", "variance": "sample variance" }
      }
    },
    "discrete_evaluation": {
      "discrete_leaves": ["categorical", "poisson", "binomial"],
      "integer_snap": "For integer-valued leaves (poisson, binomial) a query x is treated as the integer k = round(x) when |x - round(x)| <= 1e-9; otherwise log_prob(x) = -inf. cdf evaluates at the floor of the snapped value.",
      "transform_restriction": "Transforms apply change-of-variables to densities (composition_rules.transform), which is invalid for probability masses. A transform whose base subtree contains a discrete leaf MUST be rejected during semantic validation."
    },
    "composition_rules": {
      "joint": {
        "log_prob": "sum child_i.log_prob(x_i)",
        "cdf": "product child_i.cdf(x_i)",
        "sample": "sample each dimension independently",
        "moments": "per-dimension means and variances"
      },
      "mixture": {
        "validation": "weights length equals components length; weights are non-negative and sum to 1 within tolerance",
        "log_prob": "stable logsumexp_i(log(weight_i) + component_i.log_prob(x))",
        "cdf": "sum_i weight_i * component_i.cdf(x)",
        "sample": "draw component index by weights, then sample selected component",
        "moments": "E[X]=sum w_i*m_i; Var[X]=sum w_i*(v_i+m_i^2)-E[X]^2"
      },
      "transform": {
        "log_prob": "if op invertible, base.log_prob(g^-1(y)) + log_abs_derivative_of_inverse(y); otherwise unavailable",
        "cdf": "if op monotone, use base.cdf(g^-1(y)) for increasing ops and 1-base.cdf(g^-1(y)) for decreasing ops; otherwise unavailable",
        "sample": "sample base, then apply op"
      }
    },
    "transform_ops": {
      "affine": { "params": ["a", "b"], "constraints": ["a != 0"], "inverse": "(y-b)/a", "log_abs_d_inverse": "-log(abs(a))", "invertible": true, "monotone": true },
      "exp": { "params": [], "constraints": ["y > 0 for inverse"], "inverse": "log(y)", "log_abs_d_inverse": "-log(y)", "invertible": true, "monotone": true },
      "log": { "params": [], "inverse": "exp(y)", "log_abs_d_inverse": "y", "invertible": true, "monotone": true },
      "pow": { "params": ["exponent"], "constraints": ["exponent != 0", "positive branch"], "inverse": "y^(1/exponent)", "log_abs_d_inverse": "log(abs(1/exponent)) + (1/exponent - 1)*log(y)", "invertible": true, "monotone": true },
      "abs": { "params": [], "invertible": false, "monotone": false }
    },
    "validation_pipeline": [
      "Validate against this JSON Schema.",
      "Reject format_version whose MAJOR exceeds implemented major.",
      "Recheck all parameter constraints.",
      "Reject a transform op carrying params other than those listed in transform_ops (exp/log/abs take none); unexpected op params MUST NOT be silently ignored.",
      "Check mixture and categorical weight/probability sums and alignment.",
      "Check support declarations do not extend beyond natural support.",
      "Reject transform nodes whose base subtree contains a discrete leaf (see discrete_evaluation).",
      "Recompute capabilities and reject declared mismatches.",
      "Reject a bulk_ref whose decoded element count does not equal the product of its declared shape, or whose decoded byte length is not a multiple of the dtype item size.",
      "Reject unsupported optional bulk transports explicitly."
    ]
  },
  "type": "object",
  "required": ["format_version", "rv"],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "description": "Semantic version of the RV Exchange Format this document conforms to.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "metadata": {
      "description": "Optional, non-semantic annotations (name, source, units, comments). Ignored by operations.",
      "type": "object"
    },
    "rv": { "$ref": "#/$defs/rv" }
  },

  "$defs": {
    "rv": {
      "description": "A random variable node. Discriminated by the `kind` field.",
      "oneOf": [
        { "$ref": "#/$defs/leaf" },
        { "$ref": "#/$defs/joint" },
        { "$ref": "#/$defs/mixture" },
        { "$ref": "#/$defs/transform" }
      ]
    },

    "capabilities": {
      "description": "Declared operations the RV supports. MUST be revalidated by the consumer against the structural rules in SPEC.md; a mismatch is a hard error.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "can_sample": { "type": "boolean" },
        "can_log_prob": { "type": "boolean" },
        "can_cdf": { "type": "boolean" }
      }
    },

    "support": {
      "description": "Optional declared support (domain) of the RV. Bounds may be omitted to denote ±infinity.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lower": { "type": "number" },
        "upper": { "type": "number" },
        "lower_inclusive": { "type": "boolean", "default": true },
        "upper_inclusive": { "type": "boolean", "default": true }
      }
    },

    "bulk_ref": {
      "description": "Reference to a 1-D numeric array. Large arrays live in an external `.npy` sidecar referenced by path; small arrays may be inlined as base64. This keeps structural parse time independent of sample count.",
      "type": "object",
      "required": ["format", "dtype", "shape"],
      "additionalProperties": false,
      "properties": {
        "format": { "enum": ["npy", "base64"] },
        "dtype": { "enum": ["float32", "float64", "int32", "int64"] },
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 1,
          "maxItems": 1
        },
        "path": {
          "description": "Relative path or URI to a .npy file. Required when format=npy.",
          "type": "string"
        },
        "data": {
          "description": "Base64-encoded little-endian raw buffer. Required when format=base64. Recommended only for arrays under ~1024 elements.",
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "format": { "const": "npy" } } },
          "then": { "required": ["path"] }
        },
        {
          "if": { "properties": { "format": { "const": "base64" } } },
          "then": { "required": ["data"] }
        }
      ]
    },

    "leaf": {
      "description": "An atomic distribution. The concrete distribution is selected by `dist` and parameterized by `params` using canonical, library-independent parameter names (see SPEC.md).",
      "type": "object",
      "required": ["kind", "dist", "params"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "leaf" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "support": { "$ref": "#/$defs/support" },
        "metadata": { "type": "object" },
        "dist": {
          "enum": [
            "normal", "lognormal", "weibull", "uniform",
            "exponential", "gamma", "beta",
            "categorical", "poisson", "binomial", "empirical"
          ]
        },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "dist": { "const": "normal" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/params_normal" } } }
        },
        {
          "if": { "properties": { "dist": { "const": "lognormal" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/params_lognormal" } } }
        },
        {
          "if": { "properties": { "dist": { "const": "weibull" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/params_weibull" } } }
        },
        {
          "if": { "properties": { "dist": { "const": "uniform" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/params_uniform" } } }
        },
        {
          "if": { "properties": { "dist": { "const": "exponential" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/params_exponential" } } }
        },
        {
          "if": { "properties": { "dist": { "const": "gamma" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/params_gamma" } } }
        },
        {
          "if": { "properties": { "dist": { "const": "beta" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/params_beta" } } }
        },
        {
          "if": { "properties": { "dist": { "const": "categorical" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/params_categorical" } } }
        },
        {
          "if": { "properties": { "dist": { "const": "poisson" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/params_poisson" } } }
        },
        {
          "if": { "properties": { "dist": { "const": "binomial" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/params_binomial" } } }
        },
        {
          "if": { "properties": { "dist": { "const": "empirical" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/params_empirical" } } }
        }
      ]
    },

    "params_normal": {
      "type": "object", "additionalProperties": false,
      "required": ["mu", "sigma"],
      "properties": {
        "mu": { "type": "number" },
        "sigma": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "params_lognormal": {
      "description": "Parameterized by the mean (mu) and std-dev (sigma) of the underlying normal in log-space. NOTE: this differs from scipy's (s, scale) parameterization; adapters MUST map explicitly.",
      "type": "object", "additionalProperties": false,
      "required": ["mu", "sigma"],
      "properties": {
        "mu": { "type": "number" },
        "sigma": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "params_weibull": {
      "type": "object", "additionalProperties": false,
      "required": ["shape", "scale"],
      "properties": {
        "shape": { "type": "number", "exclusiveMinimum": 0 },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "params_uniform": {
      "type": "object", "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": { "type": "number" },
        "high": { "type": "number" }
      }
    },
    "params_exponential": {
      "type": "object", "additionalProperties": false,
      "required": ["rate"],
      "properties": {
        "rate": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "params_gamma": {
      "type": "object", "additionalProperties": false,
      "required": ["shape", "scale"],
      "properties": {
        "shape": { "type": "number", "exclusiveMinimum": 0 },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "params_beta": {
      "type": "object", "additionalProperties": false,
      "required": ["alpha", "beta"],
      "properties": {
        "alpha": { "type": "number", "exclusiveMinimum": 0 },
        "beta": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "params_categorical": {
      "description": "Finite discrete distribution. `categories` and `probs` are positionally aligned; `probs` must be non-negative and sum to 1 (within tolerance).",
      "type": "object", "additionalProperties": false,
      "required": ["categories", "probs"],
      "properties": {
        "categories": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        },
        "probs": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 1
        }
      }
    },
    "params_poisson": {
      "description": "Discrete count distribution over {0, 1, 2, ...} with mean `rate`.",
      "type": "object", "additionalProperties": false,
      "required": ["rate"],
      "properties": {
        "rate": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "params_binomial": {
      "description": "Discrete number of successes in `n` independent trials with success probability `p`.",
      "type": "object", "additionalProperties": false,
      "required": ["n", "p"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "p": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
      }
    },
    "params_empirical": {
      "description": "Sample-based distribution. Bulk sample data is carried by a bulk_ref (npy sidecar or inline base64).",
      "type": "object", "additionalProperties": false,
      "required": ["samples"],
      "properties": {
        "samples": { "$ref": "#/$defs/bulk_ref" }
      }
    },

    "joint": {
      "description": "Independent composition over dimensions. The joint density is the product of its dimensions' densities.",
      "type": "object",
      "required": ["kind", "dims"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "joint" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "metadata": { "type": "object" },
        "dims": {
          "type": "array",
          "items": { "$ref": "#/$defs/rv" },
          "minItems": 1
        }
      }
    },

    "mixture": {
      "description": "Weighted combination over components. `weights` and `components` are positionally aligned; weights must be non-negative and sum to 1 (within tolerance).",
      "type": "object",
      "required": ["kind", "weights", "components"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "mixture" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "metadata": { "type": "object" },
        "weights": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 1
        },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/rv" },
          "minItems": 1
        }
      }
    },

    "transform": {
      "description": "Deterministic transformation Y = op(X) of a base RV X. Invertible+differentiable ops preserve can_log_prob via change-of-variables; non-invertible ops (e.g. abs) drop it.",
      "type": "object",
      "required": ["kind", "base", "op"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "transform" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "metadata": { "type": "object" },
        "base": { "$ref": "#/$defs/rv" },
        "op": { "$ref": "#/$defs/op" }
      }
    },

    "op": {
      "description": "A scalar deterministic operation applied elementwise to the base RV.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "enum": ["affine", "exp", "log", "pow", "abs"] },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "name": { "const": "affine" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "required": ["a", "b"],
                "properties": {
                  "a": { "type": "number", "not": { "const": 0 } },
                  "b": { "type": "number" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "name": { "const": "pow" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "required": ["exponent"],
                "properties": {
                  "exponent": { "type": "number", "not": { "const": 0 } }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["name"],
            "properties": { "name": { "enum": ["exp", "log", "abs"] } }
          },
          "then": {
            "not": { "required": ["params"] },
            "description": "exp/log/abs are parameterless; carrying a params object is invalid."
          }
        }
      ]
    }
  }
}
